# Names only, never values. Copy to .env.local for local dev (never committed).
# In Cloud Run the secret ones come from Secret Manager (docs/iam.md).

# Server-only Atlas Cloud key. Without it the app runs in demo mode.
ATLASCLOUD_API_KEY=
# Emergency switch / live opt-in: "on" allows live mode, anything else forces demo mode (DP-08).
LIVE_MODE=

# Passcodes as JSON: [{"label","sha256","expiresAt","dailyBudgetUsd"}] — hashes only (DP-01).
KUMIHIMO_PASSCODES=
# HMAC key for session cookies (32+ characters).
KUMIHIMO_SESSION_SECRET=
# Salt for hashing client IPs in rate-limit counters (16+ characters).
KUMIHIMO_IP_SALT=
# The dedicated GCP project whose Firestore holds budgets and counters. Required for
# live mode in production; ambient Google credentials or GOOGLE_CLOUD_PROJECT are never used.
KUMIHIMO_FIRESTORE_PROJECT=

# Optional limits (defaults in src/server/config.ts).
KUMIHIMO_SITE_DAILY_USD=
KUMIHIMO_MAX_CONCURRENT=
KUMIHIMO_SUBMIT_PER_MINUTE=
KUMIHIMO_PASSCODE_FAIL_PER_MINUTE=
KUMIHIMO_DEMO_PER_MINUTE=
KUMIHIMO_FORWARDED_HOPS=
KUMIHIMO_SESSION_HOURS=
# Demo-mode delays × this (E2E only).
MOCK_DELAY_SCALE=

{
  "name": "kumihimo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3070",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3070",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "secrets": "gitleaks git . --redact --no-banner && gitleaks dir . --redact --no-banner && echo 'secret scan: clean'",
    "e2e": "playwright test",
    "perf": "KUMIHIMO_PERF=1 playwright test --project=perf",
    "usage-report": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/usage-report.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.3.1",
    "@xyflow/react": "^12.12.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "protobufjs"
    ]
  }
}
